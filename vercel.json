{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "traktamenteskollen.vercel.app" }],
      "destination": "https://traktamenteskollen.se/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "traktamenteskollen.vercel.app" }],
      "destination": "https://traktamenteskollen.se/:path+",
      "permanent": true
    }
  ]
}
